# Copy to .env.docker and adjust for your host.
# VM occupied ports to avoid: 3001-3004, 5678, 8000-8002, 5433, 15432, 55432, 16379

API_PORT=4000
ADMIN_PORT=3005
MOBILE_PORT=8081

# Browser-facing API URL (baked into admin + mobile at BUILD time).
# Local laptop:   http://localhost:4000
# Production VM:  https://society-api.kgt.solutions
PUBLIC_API_URL=https://society-api.kgt.solutions

# Postgres (required — Docker Compose always starts society-postgres)
POSTGRES_USER=society
POSTGRES_PASSWORD=society
POSTGRES_DB=society
POSTGRES_PORT=5434
RUN_SEED=false

JWT_SECRET=dev-secret-change-me

# Dev bypass: still sends email OTP when Resend is configured;
# always allows verifying with DEV_BYPASS_CODE as a fallback.
DEV_BYPASS_AUTH=true
DEV_BYPASS_CODE=123456

# This file's DEV_BYPASS_AUTH=true + placeholder JWT_SECRET are fine here —
# this stack always runs with NODE_ENV=production (see Dockerfile, needed
# for Express's own behavior) but is NOT a real deployment. A real
# production deployment must set DEPLOY_ENV=production (in ITS OWN env, not
# here) plus a real JWT_SECRET and DEV_BYPASS_AUTH unset/false, or the API
# refuses to boot (src/utils/assertProdSafety.js) — deliberately keyed off
# DEPLOY_ENV rather than NODE_ENV so this local/staging stack is unaffected.

# OTP delivery: email | twilio-verify | twilio-routed | local
OTP_DELIVERY=email
EMAIL_PROVIDER=resend
# Required for real email OTP (https://resend.com)
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. Testing:
# EMAIL_FROM="Society App <onboarding@resend.dev>"
EMAIL_FROM="Society App <onboarding@resend.dev>"

# Admin panel base URL (used in email CTAs)
ADMIN_WEB_URL=https://society-admin.kgt.solutions

# Bug reports inbox (optional; falls back to super admin User.email)
# SUPPORT_EMAIL=you@example.com

# Optional Twilio (only if OTP_DELIVERY is twilio-*)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_VERIFY_CHANNEL=whatsapp

# Support Chatbot (RAG over the resident/admin manuals)
# Provider chain: LLM_PRIMARY tried first, then each of LLM_FALLBACK in order
LLM_PRIMARY=groq
LLM_FALLBACK=openai,anthropic
CHAT_TEMPERATURE=0.35
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Fill in whichever providers you actually use (LLM_PRIMARY / LLM_FALLBACK above)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# At least ONE key above is required, or every chat reply is a degraded
# raw-excerpt fallback ("I couldn't reach the assistant right now…"); the API
# logs a [llm] WARNING at startup when none is set.
# Per-provider request timeout before failing over to the next provider.
LLM_TIMEOUT_MS=20000
CHAT_RATE_LIMIT_MAX=20

# Crawler Tier 2: headless Chromium fallback for JS-only sites (SPA shells)
# and bot-blocked pages. Only the super-admin "Auto-train from website URL"
# (/api/v1/tenants/:id/scrape) uses it; the public signup wizard never does.
# The image installs Chromium at /usr/bin/chromium-browser. Set to false to
# turn the fallback off without a rebuild.
CRAWLER_BROWSER_ENABLED=true
CHAT_RATE_LIMIT_WINDOW_MIN=10

# Sales Chatbot (public endpoint — no login)
SALES_EMAIL=
CHAT_ALERT_EMAIL=
INTENT_SCORE_THRESHOLD=40
SALES_CHAT_RATE_LIMIT_MAX=20
SALES_CHAT_RATE_LIMIT_WINDOW_MIN=10

# Deploy on the server with:
#   docker compose --env-file .env.docker up -d --build
# If society-postgres was left as an orphan from the SQLite compose, Compose
# will take it back once the postgres service is in docker-compose.yml again.
# Do NOT docker volume rm the postgres data volume.
