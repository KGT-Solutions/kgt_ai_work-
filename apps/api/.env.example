DATABASE_URL="postgresql://society:society@localhost:5434/society?schema=public"
JWT_SECRET="dev-secret-change-me"
PORT=4000

# Dev only — set to false in production
DEV_BYPASS_AUTH=true
DEV_BYPASS_CODE=123456

# OTP delivery
# "email"         = OTP emailed via Resend (login uses User.email; signup requires email)
# "twilio-verify" = Twilio Verify WhatsApp/SMS
# "twilio-routed" = WhatsApp sandbox for listed phones, Verify SMS otherwise
# "local"         = app generates OTP + sends via SMS provider below
OTP_DELIVERY=email

# ── Email / Resend (when OTP_DELIVERY=email) ───────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. For testing you can use:
# EMAIL_FROM="Society App <onboarding@resend.dev>"
EMAIL_FROM="Society App <onboarding@resend.dev>"

# Admin panel base URL (used in email CTAs)
ADMIN_WEB_URL=https://society-admin.kgt.solutions

# Bug reports — comma-separated emails (falls back to super admin User.email)
# SUPPORT_EMAIL=you@example.com

# Twilio Verify — WhatsApp or SMS OTP (https://console.twilio.com)
# Free trial includes credits. WhatsApp: join Twilio Sandbox first (see README).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=whatsapp

# Optional: phones that receive local WhatsApp OTP when OTP_DELIVERY=twilio-routed
# TWILIO_WHATSAPP_PHONES=+91xxxxxxxxxx

# ── Local SMS providers (only when OTP_DELIVERY=local) ─────────────
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=
# FAST2SMS_OTP_ID=

# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# SMS_PROVIDER=twilio
# TWILIO_PHONE_NUMBER=
