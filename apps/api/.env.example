# Local development (npm run dev). Docker uses ../../.env.docker instead.
DATABASE_URL="postgresql://kgthub:kgthub@localhost:5440/kgthub?schema=public"
JWT_SECRET="dev-secret-change-me"
PORT=4100
# Web app origins for the dashboard/staff APIs (default: localhost:3100, localhost:3001).
# CORS_ORIGINS=http://localhost:3001
# Proxies in front of the API; 0 when nothing is (plain `npm run dev`).
TRUST_PROXY_HOPS=0

# First operator account for the console (created by prisma/seed.js)
HUB_ADMIN_EMAIL=admin@example.com
HUB_ADMIN_PASSWORD=change-me-please
# Showcase tenant #1 (FLATBRIZ) and, optionally, a pinned key for its embed
SEED_FLATBRIZ_TENANT=true
FLATBRIZ_TENANT_API_KEY=

# LLM provider chain: LLM_PRIMARY first, then each of LLM_FALLBACK in order
LLM_PRIMARY=groq
LLM_FALLBACK=openai,anthropic
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email over SMTP (password resets, visitor lead confirmations).
# Leave SMTP_HOST empty locally and mail is printed to the API log instead;
# set it to smtp.office365.com (plus the mailbox's app password) to really send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=connect@kgt.solutions
SMTP_PASS=
SMTP_FROM="KGT Solutions <connect@kgt.solutions>"
# Re-sending to the same address is never throttled outside production;
# LEAD_CONFIRMATION_COOLDOWN_HOURS overrides that (24 = production behavior).
# LEAD_CONFIRMATION_COOLDOWN_HOURS=0

# Crawler Tier 2 (headless Chromium, operator /scrape route only)
CRAWLER_BROWSER_ENABLED=true
# CRAWLER_BROWSER_PATH=/usr/bin/chromium
