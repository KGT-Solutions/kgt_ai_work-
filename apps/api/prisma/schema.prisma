datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// KGT AI Hub: a multi-tenant Support + Sales chatbot platform. Every
// customer company is a Tenant; all of its documents, chats, tickets, usage
// and API keys hang off that row and cascade with it.

// Platform staff who manage tenants in the operator console (apps/web).
// Created by prisma/seed.js from HUB_ADMIN_EMAIL / HUB_ADMIN_PASSWORD.
model Operator {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  // Revocation kill-switch, mirroring TenantUser: a token minted at or before
  // passwordChangedAt is rejected on its next request (middleware/operatorAuth.js),
  // and a deactivated operator is locked out immediately — so a stolen operator
  // token no longer stays valid for its full 12h TTL after a password change or
  // account flag.
  passwordChangedAt DateTime?
  active            Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Tenant {
  id                   String    @id @default(uuid())
  slug                 String    @unique
  name                 String
  industryLabel        String // e.g. "Retail Customer Support", "IT Helpdesk" — shown to the model as its role
  persona              String? // optional extra tone/rules text layered onto the generic template
  outOfScopeMessage    String    @default("I'm your dedicated assistant here, and I want to make sure you get the very best care for this particular request. Would you like me to drop a quick note for our team so they can follow up with you directly?")
  minConfidence        Float     @default(0.30)
  active               Boolean   @default(true)
  // Set when provisioned via the public self-serve wizard; null for a
  // staff-created tenant. Unique: one self-serve company per email address
  // (migration 20261011090000_one_account_per_email).
  signupEmail          String?   @unique
  // Which bots the company deploys: support | sales | both (CHECK constraint
  // in migration 20261010090000_bot_preference). With one bot, that bot uses
  // all of the knowledge and the readiness audit judges only its scope
  // (services/shared/botScope.js, services/botAuditor.js).
  botPreference        String    @default("both")
  // The company's business category, chosen in the onboarding wizard
  // (ecommerce | saas | healthcare | real_estate | services | other). Drives
  // the tailored upload prompts and a light tone hint for the bots
  // (services/shared/businessCategory.js). Null for tenants created before it.
  businessCategory     String?
  // Where lead and low-confidence alerts go (services/teamAlerts.js). Null =
  // the signup email, then the tenant's dashboard users. Lower-cased.
  teamEmail            String?
  // Soft monthly AI spend cap: the maximum LLM tokens (prompt + completion) this
  // tenant may spend per calendar month before the bots stop calling the model and
  // fall back to a human handoff (engine/usageTracking.isTenantOverBudget, enforced
  // in engine/chatEngine.js). Null falls back to DEFAULT_MONTHLY_TOKEN_BUDGET; a
  // value <= 0 (or an unset default) means no cap.
  monthlyTokenBudget   Int?
  // Pre-flight knowledge audit (services/botAuditor.js): the latest report,
  // its 0-100 score and level, and a hash of the documents it judged — a
  // different hash now means documents changed since and the report is stale.
  readinessScore       Int?
  readinessLevel       String? // Not Ready | Moderate | Production Ready
  readinessReport      Json?
  readinessContentHash String?
  readinessAuditedAt   DateTime?
  createdAt            DateTime  @default(now())

  users          TenantUser[]
  documents      TenantDocument[]
  apiKeys        TenantApiKey[]
  consents       TenantConsent[]
  chatSessions   ChatSession[]
  chatImages     ChatImageAsset[]
  tickets        SupportTicket[]
  leads          Lead[]
  usageLogs      UsageLog[]
  starterFaqs    TenantFaq?
  smtpConfig     TenantSmtpConfig?
  products       ProductCatalog[]
  chunks         DocumentChunk[]
  crmIntegration TenantCRMIntegration?
  crmSyncLogs    CRMSyncLog[]
  branding       TenantBranding?
  logoAssets     TenantLogoAsset[]
  guardrails     TenantGuardrails?
  instructions   TenantInstruction[]
  emailSettings  TenantEmailSettings?
  escalation     TenantEscalationSettings?
  helpdesk       TenantHelpdeskIntegration?
  helpdeskLogs   HelpdeskSyncLog[]
  retention      TenantRetentionSettings?
  voiceUsage     TenantVoiceUsage[]
  crawlSource    TenantCrawlSource?
  crawlRuns      TenantCrawlRun[]
  webhooks          TenantWebhook[]
  webhookDeliveries WebhookDelivery[]
  sheetSync         TenantSheetSync?
}

// Structured product rows from a catalog CSV upload (services/catalogIngest.js).
// Stored alongside the readable TenantDocument the CSV is also turned into, so
// the existing RAG can answer price/product questions from its text while
// these rows keep the exact, queryable data. Strictly tenant-scoped; deleting
// the source document cascades its rows away.
model ProductCatalog {
  id          String          @id @default(uuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  document    TenantDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String?
  name        String
  sku         String
  price       String // kept as text: currencies, ranges and "POA" are all valid
  description String          @default("")
  category    String? // the item's own category/type (e.g. "Electronics", "Course"), not the tenant's business category
  imageUrl    String? // an image/picture URL for the product or course
  productUrl  String? // a direct product / purchase / checkout link shown on the card
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId])
  @@index([tenantId, sku])
}

// A tenant's own outbound SMTP, so ticket alerts, lead emails and other
// notifications go out from their domain instead of the platform mailbox
// (services/mailer.js falls back to the global SMTP when this is absent or
// disabled). smtpPass is stored ONLY as AES-256-GCM ciphertext
// (utils/encryption.js) and is never returned to the client — the API masks
// it. One row per tenant.
model TenantSmtpConfig {
  id        String   @id @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String   @unique
  provider  String? // 'gmail' | 'outlook' | null (custom) — drives the UI's provider picker and help text
  smtpHost  String
  smtpPort  Int      @default(587)
  smtpUser  String
  smtpPass  String // AES-256-GCM ciphertext (never plaintext, never sent to the client)
  smtpFrom  String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Starter questions for the Test Bots sandbox, written by an LLM from this
// tenant's own documents (services/tenantFaqs.js) after a website import,
// PDF upload or signup. One row per tenant; regenerating overwrites it.
// status: pending (generation queued/running) | ready | failed. A failed
// regeneration keeps the previous questions, so the sandbox never goes blank.
model TenantFaq {
  id            String    @id @default(uuid())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String    @unique
  supportFaqs   String[]  @default([]) // English starter questions (index-aligned with the *Hi arrays)
  salesFaqs     String[]  @default([])
  supportFaqsHi String[]  @default([]) // Hindi variants, same order; falls back to English where a translation is missing
  salesFaqsHi   String[]  @default([])
  status        String    @default("pending")
  error         String? // last failure reason, for staff; never shown to clients
  generatedAt   DateTime? // when the current questions were written
  updatedAt     DateTime  @updatedAt
}

// A client company's own login to its dashboard (/dashboard). Belongs to
// exactly one tenant and can only ever see that tenant's data: the client
// JWT carries this user's id, and middleware/clientAuth.js resolves the
// tenant from the database row, never from anything the client sends.
// Created by the signup wizard (/api/v1/public/register/complete).
model TenantUser {
  id                String    @id @default(uuid())
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId          String
  // One account per email address. Always stored lower-cased and trimmed
  // (CHECK constraint in migration 20261011090000_one_account_per_email), so
  // "Ana@Acme.com" and "ana@acme.com" can never become two accounts.
  email             String    @unique
  name              String?
  passwordHash      String
  createdAt         DateTime  @default(now())
  lastLoginAt       DateTime?
  // Sessions issued before this moment are rejected (middleware/clientAuth.js),
  // so resetting a password signs the account out everywhere.
  passwordChangedAt DateTime?

  resetCodes PasswordResetCode[]

  @@index([tenantId])
}

// One-time 6-digit code for the forgot-password flow (routes/clientAuth.routes.js).
// Only a hash of the code is stored; it expires after 10 minutes, locks after
// 5 wrong attempts, and is single-use. Requesting a new code voids older ones.
model PasswordResetCode {
  id        String     @id @default(uuid())
  user      TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int        @default(0)
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId])
}

// Proof that a signup email address belongs to the person signing up
// (services/verificationService.js). One row per address: requesting a new
// code replaces the old one. Only an HMAC of the 6-digit code is stored;
// it expires after 10 minutes and locks after 5 wrong attempts. Once
// verified it's valid for 2 hours and is consumed (usedAt) by the
// /register/complete call that creates the account.
model EmailVerification {
  id         String    @id @default(uuid())
  email      String    @unique // lower-cased
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  usedAt     DateTime?
  lastSentAt DateTime  @default(now()) // drives the resend cooldown
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Widget/API credentials. Only a SHA-256 hash of each key is stored — the
// plaintext is shown once when issued (utils/tenantApiKeys.js) and can't be
// recovered, only rotated. Several keys per tenant, so a key can be replaced
// without downtime: issue the new one, update the embed, then revoke the old.
model TenantApiKey {
  id             String    @id @default(uuid())
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  keyHash        String    @unique // sha256 hex of the full plaintext key
  keyPrefix      String // first chars of the key, e.g. "tk_3f9a1c" — lets admins tell keys apart
  label          String    @default("Default")
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime? // updated at most every few minutes, not on every request
  revokedAt      DateTime? // non-null = rejected; kept for the audit trail rather than deleted
  // Widget install telemetry: set when the embed widget pings on page load
  // (POST /api/v1/tenant-chat/:slug/ping). Null = never loaded. Throttled like
  // lastUsedAt. widgetUrl is the page it last loaded on (origin + path only).
  widgetSeenAt   DateTime?
  widgetUrl      String?
  // Websites allowed to use this key from a browser, as origins
  // ("https://www.acme.com"). The key ships in the public embed snippet, so
  // without a list any site could embed it and spend this tenant's budget.
  // Empty = any origin (keys issued before this field existed keep working).
  allowedOrigins String[]  @default([])

  @@index([tenantId])
}

enum ConsentKind {
  WEBSITE_CRAWL // visitor certified they may authorize crawling this domain
}

// Audit record of an authorization the visitor gave during self-serve signup.
// statement is the server's copy of the text at statementVersion, not whatever
// the client sent, so the record reflects what we actually asked people to agree to.
model TenantConsent {
  id               String      @id @default(uuid())
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         String
  kind             ConsentKind
  domain           String? // the crawled host, for WEBSITE_CRAWL
  statement        String
  statementVersion String
  email            String // who gave it (the signup email)
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime    @default(now())

  @@index([tenantId])
}

// Universal 3-tier knowledge taxonomy (sector-neutral). Mirrored as string
// constants in src/services/shared/documentCategory.js — keep in sync.
enum DocumentCategory {
  CORE_OVERVIEW // who the company is, what it offers, positioning
  FAQ // question/answer content, troubleshooting
  CUSTOM_POLICY // pricing, policies, terms, manuals, spec sheets
}

// Mirrored as DOC_SCOPES in src/services/shared/botScope.js — keep in sync.
enum BotScope {
  AUTO // each section classified on its own
  BOTH // both bots
  SUPPORT // Support Bot only
  SALES // Sales Bot only
}

model TenantDocument {
  id        String           @id @default(uuid())
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  title     String
  content   String // plain markdown/text — parsed into chunks the same way docs/*.md files are
  category  DocumentCategory @default(CORE_OVERVIEW) // drives per-bot retrieval weighting (domains/tenantProfile.js)
  sourceUrl String? // set when this document came from the auto-scraper; null for a hand-authored one
  // Which bot may use it (services/shared/botScope.js): AUTO classifies each
  // section separately; BOTH / SUPPORT / SALES apply to the whole document.
  botScope  BotScope         @default(AUTO)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  products  ProductCatalog[]
  chunks    DocumentChunk[]

  @@index([tenantId])
  @@index([tenantId, category])
}

// The semantic half of hybrid retrieval (src/engine/hybridRetriever.js). One
// row per "## section" chunk of a TenantDocument — the SAME split the lexical
// path derives in memory (domains/tenantProfile.documentChunks), so both sides
// share one chunk identity (chunkKey = "<documentId>#<sectionIndex>") and RRF
// can fuse them. TenantDocument.content stays the source of truth; these rows
// are rebuilt on every document write by services/shared/chunkStore.syncTenantChunks.
//
// `embedding` is a pgvector column (vector(1536), OpenAI text-embedding-3-small),
// declared Unsupported because Prisma has no native vector type — it is read and
// written only through $queryRaw/$executeRaw, never the typed client, and is
// NULL when embeddings are unavailable (no key / API down), in which case the
// row simply doesn't participate in vector search and lexical retrieval still works.
model DocumentChunk {
  id             String                       @id @default(uuid())
  tenant         Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  document       TenantDocument               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId     String
  chunkKey       String                       // "<documentId>#<sectionIndex>" — stable across re-syncs
  title          String
  content        String
  category       DocumentCategory             @default(CORE_OVERVIEW)
  scope          String                       // resolved bot scope for this chunk (both | support | sales)
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?                      // which model produced `embedding`; null until embedded
  contentHash    String                       // detects unchanged text so re-sync skips re-embedding
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([tenantId, chunkKey])
  @@index([tenantId])
  @@index([documentId])
}

// One conversation with one visitor. botType, lastMessageAt and messageCount
// are kept up to date on every turn (services/tenantChat.js). summary is the
// AI summary of the whole conversation (services/chatSessions.js), written
// once it goes idle or ends; for a conversation that produced a lead, the
// lead's summary (services/leads.js) is copied here instead of a second call.
model ChatSession {
  id               String        @id @default(uuid())
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         String
  externalUserId   String? // identity from whatever host app is embedding the widget — opaque to us
  startedAt        DateTime      @default(now())
  // support | sales — the bot of the first turn (CHECK constraint in
  // migration 20261016090000_session_summaries_team_alerts)
  botType          String?
  lastMessageAt    DateTime?
  messageCount     Int           @default(0)
  endedAt          DateTime? // the widget reported the page closed (POST /session/end)
  summary          String?
  summaryStatus    String        @default("none") // none | pending | ready | failed
  summarizedAt     DateTime? // when the last attempt finished; older than lastMessageAt = stale
  // Lease taken when an API instance starts writing this conversation's
  // summary. The claim is what stops two instances paying for the same
  // summary twice (services/chatSessions.js); a claim older than
  // SESSION_SUMMARY_LEASE_MIN means the holder died mid-run, so the
  // conversation becomes claimable again instead of being stuck pending.
  summaryClaimedAt DateTime?
  // A paused conversation gets no bot replies until a human resumes it
  // (services/tenantChat.js). Set by spam auto-detection or from Chat Logs.
  pausedAt         DateTime?
  pauseReason      String? // spam | manual — CHECK constraint in migration 20261121090000_chat_session_pause
  messages         ChatMessage[]

  @@index([tenantId])
  @@index([tenantId, lastMessageAt])
  @@index([lastMessageAt])
}

// Full-site sitemap sync source + weekly auto-refresh schedule (Feature 2,
// services/knowledgeSync.js). One row per tenant: the website to keep in sync
// and whether the weekly background refresh is on. The run history lives in
// TenantCrawlRun. Strictly tenant-scoped.
model TenantCrawlSource {
  id            String    @id @default(uuid())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String    @unique
  url           String? // the site to sync from its sitemap; null = not configured
  weeklyEnabled Boolean   @default(false) // weekly background auto-refresh (gated by KNOWLEDGE_SYNC_ENABLED)
  lastRunAt     DateTime?
  lastRunId     String? // the most recent TenantCrawlRun id (not a FK — a run may be pruned)
  lastStatus    String? // completed | failed — mirror of the last run's status
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// One sitemap-sync run and its change report (Feature 2). report holds the
// structured per-page detail ({ counts, pages:[{url,title,status,error?}], sitemaps }).
// trigger: manual | scheduled. status: running | completed | failed.
model TenantCrawlRun {
  id              String    @id @default(uuid())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String
  sourceUrl       String
  trigger         String    @default("manual") // manual | scheduled — CHECK constraint in migration
  status          String    @default("running") // running | completed | failed — CHECK constraint in migration
  pagesDiscovered Int       @default(0)
  pagesAdded      Int       @default(0)
  pagesUpdated    Int       @default(0)
  pagesRemoved    Int       @default(0)
  pagesUnchanged  Int       @default(0)
  errorsCount     Int       @default(0)
  report          Json? // { counts, pages: [{ url, title, status, error? }], sitemaps }
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([tenantId])
  @@index([tenantId, startedAt])
}

model ChatMessage {
  id         String      @id @default(uuid())
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  role       String // user | assistant
  content    String
  confidence Float? // the gate score behind this assistant reply, if applicable
  // support | sales — which bot this turn went to; null on rows from before
  // per-bot tracking. CHECK constraint in migration 20261002090000_bot_type_check.
  botType    String?
  // true on an assistant reply the model wrote from the knowledge base; false
  // on greetings, handoffs, "can't answer that" and outage replies. The
  // visitor's confirmation email recaps only these (services/leads.js).
  answered   Boolean     @default(false)
  // Content keys of the visitor images attached to this (user) turn, each a
  // ChatImageAsset of the same tenant (services/shared/chatImage.js). Empty on
  // every assistant row and on text-only turns.
  imageKeys  String[]    @default([])
  // How the visitor sent this turn: 'text' (typed) or 'voice' (Speech-to-Speech,
  // services/voiceChat.js). Set on both rows of a voice turn so Chat Logs and the
  // CSV export can show a "Voice" tag. CHECK constraint in migration
  // 20261127090000_voice_source_minutes.
  source     String      @default("text")
  createdAt  DateTime    @default(now())

  @@index([sessionId])
}

// A visitor-uploaded chat image, re-encoded through sharp so every EXIF/GPS
// block is dropped, stored once per tenant by the sha256 of its processed bytes
// (so the same photo sent twice is one row). Served by the scoped, content-
// addressed route (routes/chatImages.routes.js); referenced from
// ChatMessage.imageKeys. Never written for the dashboard's own test chat.
model ChatImageAsset {
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String // sha256 hex prefix of the processed bytes
  data      Bytes
  mimeType  String // image/jpeg | image/png | image/webp
  width     Int
  height    Int
  bytes     Int
  createdAt DateTime @default(now())

  @@id([tenantId, key])
  @@index([tenantId])
}

model SupportTicket {
  id           String   @id @default(uuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  query        String
  transcript   Json // recent turns, for whoever picks this up
  confidence   Float? // the score below the handoff threshold; null for requests (demo, human, contact)
  // unanswered | outage | human_request | demo_request | contact_request
  // (CHECK constraint in migration 20261002120000_conversational_handoffs)
  kind         String   @default("unanswered")
  botType      String? // support | sales
  sessionId    String? // the conversation, so an email left later attaches here
  contactEmail String? // left by the visitor in the chat
  status       String   @default("open")
  // Human Escalation (Feature 5). The reply ETA shown to the visitor when this
  // ticket was raised (services/escalation.js), e.g. "within about 30 minutes" —
  // a snapshot, so it reads the same later even if business hours change. The
  // helpdesk mirror: which external helpdesk this ticket was pushed to and its
  // id there, set once services/helpdesk/helpdeskSync.js creates it. Null = not
  // (yet) synced; a down or unconfigured helpdesk simply leaves these null.
  replyEta         String?
  helpdeskProvider String? // 'zoho_desk' | 'freshdesk'
  helpdeskTicketId String?
  createdAt    DateTime @default(now())

  @@index([tenantId, status])
  @@index([tenantId, sessionId])
}

enum LeadStatus {
  NEW // not yet followed up
  CONTACTED // someone on the tenant's team has reached out
}

// A visitor who left an email in a bot conversation (services/leads.js).
// One row per conversation, bot and email: leaving the same email again
// updates it rather than adding another. fullTranscript and chatSummary are
// rewritten in the background as the conversation goes on, so the summary
// covers what was said after the email too.
model Lead {
  id                 String       @id @default(uuid())
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId           String
  // support | sales (CHECK constraint in migration 20261005090000_leads)
  botType            String
  sessionId          String? // the ChatSession the email was left in
  email              String
  chatSummary        String? // the LLM's executive summary; null until one is written
  summaryStatus      String       @default("pending") // pending | ready | failed
  fullTranscript     Json         @default("[]") // [{ role, content, botType, at }], oldest first
  status             LeadStatus   @default(NEW)
  confirmationSentAt DateTime? // when the "we've received your request" email went out
  // CRM mirror (services/crm/zohoSync.js). crmRecordId is the id of this lead
  // in the tenant's CRM, set once it's created/matched there, so an inbound
  // status webhook (routes/crmWebhook.routes.js) can map a CRM record back to
  // this row. Null until the lead has been synced.
  crmProvider        CRMProvider?
  crmRecordId        String?
  crmSyncedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // One lead per visitor email per conversation and bot: the database, not a
  // find-then-create, decides — two simultaneous captures otherwise both
  // inserted (and both alerted the team and synced to the CRM). A null
  // sessionId never collides (Postgres treats NULLs as distinct).
  @@unique([tenantId, botType, sessionId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId, sessionId])
  @@index([tenantId, email])
  @@index([tenantId, crmRecordId])
  // The inbound Zoho webhook (zohoSync.applyInboundStatus) finds a lead by its
  // CRM record id, usually with no tenant hint — the index above leads with
  // tenantId, so without this one that lookup scans the whole table.
  @@index([crmProvider, crmRecordId])
}

// ── CRM integration (services/crm/*). A tenant can connect one external CRM
// (Zoho today, HubSpot modelled for later) so captured leads mirror into it
// and sales-rep status changes mirror back. OAuth tokens are stored ONLY as
// AES-256-GCM ciphertext (utils/encryption.js), exactly like SMTP passwords,
// and are never returned to the client or logged.

enum CRMProvider {
  ZOHO
  HUBSPOT
}

enum CRMSyncStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

model TenantCRMIntegration {
  id           String      @id @default(uuid())
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String      @unique // one CRM connection per tenant
  provider     CRMProvider @default(ZOHO)
  // The CRM data centre / regional domain: 'in' (zohoapis.in), 'com', 'eu',
  // 'au', 'jp', ... — resolved to a base URL in services/crm/zohoAuth.js.
  region       String      @default("com")
  // HubSpot account (hub/portal) id, captured at connect from the token
  // introspection endpoint (services/crm/hubspotAuth.js). Null for Zoho. An
  // inbound HubSpot webhook carries only the portalId + object id, so this maps
  // an event back to the right tenant (routes/crmWebhook.routes.js) and keeps
  // a contact id — unique only WITHIN a portal — from colliding across tenants.
  portalId     String?
  accessToken  String? // AES-256-GCM ciphertext; short-lived, refreshed on expiry
  refreshToken String? // AES-256-GCM ciphertext; long-lived, mints access tokens
  tokenExpiry  DateTime? // when accessToken stops being valid
  // Editable KGT→CRM field map, e.g. { "email": "Email", "phone": "Phone",
  // "name": "Last_Name" }. Defaults are applied in code when a key is absent.
  fieldMapping Json        @default("{}")
  isEnabled    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  syncLogs CRMSyncLog[]

  @@index([tenantId])
  // Inbound HubSpot webhooks look a tenant up by (provider, portalId).
  @@index([provider, portalId])
}

// Audit trail of every sync attempt, in either direction, so a failed or
// retrying sync can always be traced. error holds a safe summary only
// ({ message, statusCode }) — never the raw provider body, tokens or secrets.
model CRMSyncLog {
  id            String                @id @default(uuid())
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String
  integration   TenantCRMIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  integrationId String?
  leadId        String? // the KGT Lead this sync was for, when applicable
  provider      CRMProvider           @default(ZOHO)
  direction     String                @default("outbound") // outbound (KGT→CRM) | inbound (CRM→KGT)
  operation     String // lead.upsert | note.attach | webhook.status
  status        CRMSyncStatus         @default(PENDING)
  crmRecordId   String? // the CRM record id, once known
  attempts      Int                   @default(0)
  error         Json? // { message, statusCode? } — never raw bodies or secrets
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([tenantId, createdAt])
  @@index([leadId])
}

// One row per answer that would have cost an LLM call: a real call, or a
// repeat question served from the in-memory answer cache (engine/answerCache.js).
// A cache hit records 0 tokens and $0, and what the original call cost in
// savedTokens / savedCostUsd, so dashboards can show what the cache saved.
model UsageLog {
  id               String   @id @default(uuid())
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         String
  // support | sales for chat answers; null for platform work done for the
  // tenant (starter-FAQ generation) and for rows from before per-bot tracking.
  // CHECK constraint in migration 20261002090000_bot_type_check.
  botType          String?
  provider         String // groq | openai | anthropic | cache
  model            String
  promptTokens     Int
  completionTokens Int
  estimatedCostUsd Float    @default(0)
  cacheHit         Boolean  @default(false)
  savedTokens      Int      @default(0)
  savedCostUsd     Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, botType, createdAt])
}

// ── Bot Branding & Theme Studio (services/branding.js). The company's brand
// kit — scraped from its homepage at signup (services/shared/brandExtractor.js)
// or edited in the dashboard — and the three widget designs generated from it
// (services/shared/themeGenerator.js). selectedThemeId is the design the
// embeddable widget renders; null keeps the classic widget look.
// A hosted logo: the image as the server re-encoded it (PNG, at most 512px,
// metadata stripped — never the uploaded bytes), served publicly at
// /api/v1/public/brand-assets/logo/:tenantId/:key.png. Its own table so the
// bytes are never read along with every TenantBranding row.
//
// Content-keyed: one row per (tenant, image). A new logo is INSERTED beside
// the old one and TenantBranding.customLogoKey switched to it in the same
// transaction, which then deletes every other row of the tenant — so the live
// key always has its row, and a failed or concurrent change can never leave
// the widget pointing at a deleted image (services/branding.js commitBranding).
model TenantLogoAsset {
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String // sha256 prefix of data; TenantBranding.customLogoKey when live
  data      Bytes
  mimeType  String   @default("image/png")
  width     Int
  height    Int
  // The "reversed" logo for headers the original doesn't contrast with: its
  // neutral parts (dark lettering, grey taglines) flipped light — or dark, for
  // a light logo — and its brand colours kept (logoUpload.js reverseNeutrals).
  // Null when a reversal wouldn't help (a single-colour mark is tinted by CSS
  // instead; an all-colour mark has no neutrals to flip).
  reversedKey  String?
  reversedData Bytes?
  createdAt DateTime @default(now())

  @@id([tenantId, key])
  // The public route resolves a reversed key too (branding.js getLogoAsset).
  @@index([tenantId, reversedKey])
}

model TenantBranding {
  id              String    @id @default(uuid())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String    @unique
  logoUrl         String?
  faviconUrl      String?
  // Distinct brand colours found on the site, strongest first: ["#1a73e8", ...]
  scrapedColors   Json      @default("[]")
  // { primaryColor, secondaryColor, accentColor, fontHints, siteName }
  brandTokens     Json      @default("{}")
  // The three generated widget designs (themeGenerator.js shape).
  generatedThemes Json      @default("[]")
  selectedThemeId String?
  // The bot's display name in the widget header ("Support Assistant", "Aria").
  // Null = the widget's default title. Independent of the applied design.
  botName         String?
  // The free "Powered by KGT Orb" footer strip in the widget and its preview.
  // Owner-toggleable at no charge; true = shown. The permanent "You are chatting
  // with an AI assistant" notice is NOT governed by this and can never be hidden.
  showBranding    Boolean   @default(true)
  // The logo the client uploaded themselves (TenantLogoAsset), by content
  // hash — part of its public URL, so a new upload is a new URL and browsers
  // never show a stale cached one. Non-null = it is THE logo, ahead of logoUrl.
  customLogoKey   String?
  source          String    @default("fallback") // website | manual | fallback
  sourceUrl       String?
  scannedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Per-tenant Guardrails settings (one row per tenant, created on first save;
// absent = platform defaults). Owner-tunable from the dashboard Guardrails
// screen. This is only the SCAFFOLD — the config store and its endpoints;
// enforcement (per-device limits, spam auto-pause, country block) and image
// persistence are built on top of it later.
model TenantGuardrails {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String @unique

  // Per-device rate limit ("maxMessages every windowSeconds"); null = platform default.
  maxMessages   Int?
  windowSeconds Int?
  // Shown to a visitor in place of a reply when the limit is hit; null = default copy.
  limitMessage  String?

  // Auto-pause a conversation detected as spam (checked at the visitor's
  // 2nd/4th/8th/16th message). Off by default.
  spamCheckEnabled Boolean @default(false)

  // ISO-3166 alpha-2 codes whose visitors are blocked (widget hidden). IP
  // geolocation is advisory — a VPN defeats it — so this is a deterrent, not a
  // security control. Empty = no country blocked.
  blockedCountries String[] @default([])

  // Master toggle for visitor image uploads in chat.
  imagesEnabled Boolean @default(true)

  // Monthly Speech-to-Speech allowance in minutes (Feature 4). null = platform
  // default (env VOICE_MONTHLY_MINUTES_DEFAULT); 0 = unlimited. Metered per UTC
  // month in TenantVoiceUsage (services/voiceUsage.js).
  voiceMonthlyMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Monthly voice-minute metering for Speech-to-Speech (Feature 4). One row per
// (tenant, UTC month); secondsUsed accumulates the estimated spoken-input
// duration of each live voice turn (services/voiceUsage.js). The cap itself is
// TenantGuardrails.voiceMonthlyMinutes; this is only the running tally. Sandbox
// test chats never write here.
model TenantVoiceUsage {
  id          String   @id @default(uuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  period      String // 'YYYY-MM' (UTC)
  secondsUsed Int      @default(0)
  turns       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, period])
  @@index([tenantId])
}

// Client-facing Instructions Editor (Feature 11): the business owner's tone /
// style / length preferences and free-text guidance per assistant (Support /
// Sales). These are layered onto the system prompt AFTER the locked grounding,
// safety, pricing, scope and privacy rules and explicitly subordinate to them
// (domains/tenantProfile.js + services/tenantInstructions.js) — they can shape
// how an answer sounds, never what facts it may state or which questions it may
// answer. One row per (tenant, botType); absent = the stock persona, unchanged.
model TenantInstruction {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  botType  String // 'support' | 'sales'

  // Preset controls (null = unset → that line is simply omitted from the prompt).
  tone   String? // friendly | professional | playful | formal | empathetic
  style  String? // concise | detailed | conversational | direct
  length String? // short | medium | long
  // Free-text style/tone guidance, bounded and sanitised before storage.
  guidance String?

  // Monotonic revision counter; the newest saved state. Each save appends a
  // TenantInstructionVersion snapshot with this number.
  version   Int      @default(1)
  updatedBy String? // actor email, else role ('client' | 'operator')
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions TenantInstructionVersion[]

  @@unique([tenantId, botType])
  @@index([tenantId])
}

// One saved revision of a TenantInstruction, for the version-history panel:
// view and restore a previous version. A restore writes a NEW version whose
// content copies the chosen one, so history is append-only and auditable.
model TenantInstructionVersion {
  id            String            @id @default(uuid())
  instruction   TenantInstruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  instructionId String
  tenantId      String // denormalised for scoped lookups
  botType       String
  version       Int

  tone     String?
  style    String?
  length   String?
  guidance String?

  // Metadata: a short human summary of the change, and who made it.
  summary String?
  actor   String?

  createdAt DateTime @default(now())

  @@index([instructionId, version])
  @@index([tenantId, botType, version])
}

// Email Connection (Feature 10). One row per tenant holding BOTH an optional
// Google/Microsoft OAuth send connection (services/emailConnection.js, sending
// through the Gmail API / Microsoft Graph with send-only scopes) AND the
// per-email-type toggles enforced before each category is sent. Custom SMTP
// stays in TenantSmtpConfig and is unaffected; mailer.js prefers an OAuth
// connection, then SMTP, then the platform transport. OAuth tokens are
// encrypted at rest (utils/encryption.js) and never returned to the client.
model TenantEmailSettings {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String @unique

  // OAuth send connection. null provider = not connected (SMTP/platform used).
  provider     String? // 'google' | 'microsoft'
  oauthEmail   String? // the connected mailbox; used as the From address
  refreshToken String? // encrypted (AES-256-GCM); the long-lived grant
  accessToken  String? // encrypted; a short-lived cache, refreshed as needed
  tokenExpiry  DateTime?
  scope        String?
  connectedAt  DateTime?
  connectedBy  String? // actor email/role that connected it

  // Per-email-type toggles (default on). Enforced server-side before each send
  // (services/teamAlerts.js, services/leads.js). Account-security emails
  // (password reset, signup verification) are NOT governed here and always send.
  leadAlertsEnabled          Boolean @default(true) // "new lead captured" alerts to the team
  attentionAlertsEnabled     Boolean @default(true) // handoff / low-confidence alerts to the team
  visitorConfirmationEnabled Boolean @default(true) // the confirmation email to the visitor who left an email

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Generic outbound webhooks (Feature 8, services/webhooks.js). A tenant
// registers HTTP endpoints and subscribes each to one or more events
// (lead.created, ticket.created, chat.session.completed). On an event we POST a
// signed JSON envelope to every matching endpoint. The signing `secret` is stored
// ONLY as AES-256-GCM ciphertext (utils/encryption.js) and is returned to the
// client just once, at creation/rotation. Strictly tenant-scoped.
model TenantWebhook {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  url         String
  secret      String // encrypted (AES-256-GCM); the HMAC signing key, never returned after creation
  events      String[] @default([]) // subscribed event names
  enabled     Boolean  @default(true)
  description String?

  // Rollup of the latest delivery, for the dashboard list.
  lastStatus     String? // 'success' | 'failed'
  lastDeliveryAt DateTime?
  failureCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId])
}

// One webhook delivery outcome (an attempt-set per event). Stores ONLY the status
// code and a short error message — never the request body, the secret, or any
// response body (same discipline as the CRM/helpdesk sync logs).
model WebhookDelivery {
  id        String        @id @default(uuid())
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  webhook   TenantWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  webhookId String

  event      String
  status     String // 'success' | 'failed'
  statusCode Int?
  attempts   Int     @default(1)
  error      String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([webhookId, createdAt])
}

// ── Google Sheets sync (Feature 8, services/sheetsSync.js). A tenant connects a
// Google account (the SAME OAuth app as the email connection, with the
// spreadsheets scope) and picks a spreadsheet; subscribed events append a row.
// Tokens are stored ONLY as AES-256-GCM ciphertext and never returned to the
// client. One row per tenant. Append is fire-and-forget and fails safe.
model TenantSheetSync {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String @unique

  // OAuth connection. null refreshToken = not connected.
  refreshToken   String? // encrypted; the long-lived grant
  accessToken    String? // encrypted; a short-lived cache, refreshed as needed
  tokenExpiry    DateTime?
  scope          String?
  connectedEmail String? // the connected Google account
  connectedAt    DateTime?
  connectedBy    String? // actor email/role that connected it

  // What to write, and where.
  spreadsheetId   String?
  spreadsheetName String?  // the sheet/tab name to append to (null = Sheet1)
  events          String[] @default(["lead.created"])
  enabled         Boolean  @default(false)

  lastStatus String?
  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Human Escalation (Feature 5, services/escalation.js). Per-tenant control of
// WHEN a conversation hands off to a person and WHAT the visitor is told to
// expect. One row per tenant; absent = the platform defaults (no extra trigger
// phrases, no ETA promised). These never weaken the grounded chat: a trigger
// keyword only routes to the existing handoff path, it can't change an answer.
model TenantEscalationSettings {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String @unique

  // Extra phrases that, if a visitor's message contains one, trigger a handoff
  // on top of the built-in "talk to a human" detection (domains/handoffActions.js).
  // Lower-cased, de-duplicated, bounded. keywordsEnabled is the master switch.
  triggerKeywords String[] @default([])
  keywordsEnabled Boolean  @default(true)

  // Business hours, for the reply-ETA message. An IANA timezone (e.g.
  // "Asia/Kolkata"; null = UTC) and a per-weekday list of open ranges:
  // { "mon": [["09:00","17:00"]], "sat": [], ... }. An empty object means hours
  // aren't configured, so no ETA is computed.
  businessTimezone String?
  businessHours    Json    @default("{}")

  // Reply ETA. Inside business hours the visitor is told replies come within
  // replyEtaMinutes (null = a generic "as soon as we can"); outside hours they
  // see offHoursEtaText (null = a generic "when we're back" line).
  replyEtaMinutes Int?
  offHoursEtaText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Helpdesk integration (Feature 5, services/helpdesk/*). A tenant can connect
// ONE external helpdesk (Zoho Desk or Freshdesk) so an escalated chat opens a
// real ticket there. Credentials are stored ONLY as AES-256-GCM ciphertext
// (utils/encryption.js), exactly like SMTP passwords and CRM tokens, and are
// never returned to the client. Ticket creation is fire-and-forget and fails
// safe: a down or unconfigured helpdesk never breaks the chat or the handoff.
model TenantHelpdeskIntegration {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String @unique

  provider  String  // 'zoho_desk' | 'freshdesk' (CHECK constraint in the migration)
  isEnabled Boolean @default(true)

  // Freshdesk: the account subdomain ("acme" or "acme.freshdesk.com") and the
  // API key (encrypted). Basic auth, no OAuth.
  freshdeskDomain String?
  apiKey          String? // encrypted

  // Zoho Desk: OAuth via the platform's Zoho app (ZOHO_CLIENT_ID/SECRET) plus a
  // per-tenant refresh token (encrypted) at a data-centre region, an org id and
  // an optional department the tickets land in. accessToken is a short-lived
  // cache refreshed as needed (services/crm/zohoAuth.js machinery is reused).
  region       String?
  orgId        String?
  departmentId String?
  refreshToken String? // encrypted
  accessToken  String? // encrypted
  tokenExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs HelpdeskSyncLog[]
}

// Audit trail of every helpdesk ticket-creation attempt, so a failed or skipped
// push can always be traced from the dashboard. error holds a safe summary only
// ({ message, statusCode }) — never the raw provider body, keys or tokens.
model HelpdeskSyncLog {
  id            String                     @id @default(uuid())
  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String
  integration   TenantHelpdeskIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  integrationId String?
  ticketId      String? // the KGT SupportTicket this push was for
  provider      String // 'zoho_desk' | 'freshdesk'
  operation     String  @default("ticket.create")
  status        String  @default("PENDING") // PENDING | SUCCESS | FAILED | SKIPPED
  externalTicketId String? // the helpdesk's own ticket id, once known
  attempts      Int     @default(0)
  error         Json? // { message, statusCode? } — never raw bodies or secrets
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([ticketId])
}

// ── Chat-log retention (Feature 16, services/retention.js). Per-tenant policy
// for how long conversations are kept. One row per tenant; absent = keep for
// ever (the platform default). A purge deletes whole ChatSessions older than the
// window, which cascades their ChatMessages; it is guarded (a dry-run first, a
// minimum floor) so it can never wipe recent, active conversations by accident.
model TenantRetentionSettings {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String @unique

  // Keep conversations whose last activity is within this many days; older ones
  // are eligible for purge. Null = keep for ever (nothing is ever purged).
  retentionDays   Int?
  // When on, the background sweep (services/retention.js) purges on a schedule;
  // off = a purge only happens when someone runs it from the dashboard.
  autoPurgeEnabled Boolean @default(false)

  lastPurgeAt      DateTime?
  lastPurgedCount  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
