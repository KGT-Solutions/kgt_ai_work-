# Dependencies (largest folders — never commit)
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
out/
dist/
build/
.expo/
.expo-shared/
web-build/

# Local databases & runtime data
*.db
*.db-journal
*.sqlite
*.sqlite3
apps/api/prisma/dev.db
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# Environment & secrets (commit *.example only)
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.docker
# Any other dotfile ending in .docker is a stray env file (e.g. a ".eve.docker" typo)
.*.docker
!.env.docker.example
apps/api/.env
apps/mobile/.env
apps/admin-web/.env.local

# Logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# OS & editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# Test & coverage
coverage/
.nyc_output/

# TypeScript / cache
*.tsbuildinfo
.turbo/
.cache/
.parcel-cache/

# Docker (local overrides; keep compose + example env)
docker-compose.override.yml

# Misc binaries & large media (prevent accidental commits)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.dmg
*.iso
*.mp4
*.mov
*.avi
*.mkv
*.psd
*.ai

# Uploaded user content
uploads/
!uploads/.gitkeep

# Database dumps contain personal data — never commit them.
backup_*.sql
*.dump
*.sql
# ...but Prisma migrations are schema, not data, and must be committed.
!apps/api/prisma/migrations/*/migration.sql

# Local tunnel/widget experiments — never commit (test pages embed live API keys)
*.deb
/test.html

# End-to-end test output (e2e/)
e2e/playwright-report/
e2e/test-results/

# ── Documentation PDFs ──────────────────────────────────────────────
# The build pipeline is source and must be tracked: the generic `build/`
# rule above matches any directory named build, which would otherwise
# swallow docs/pdf/build/ whole. Un-exclude the directory, then ignore
# only the artifacts regenerated inside it.
!docs/pdf/build/
docs/pdf/build/assets/*.woff2
docs/pdf/build/assets/mermaid.min.js
docs/pdf/build/assets/geist.css
docs/pdf/build/assets/fonts.css
docs/pdf/build/*.html
docs/pdf/build/*-bleed.pdf
docs/pdf/build/*-body.pdf
docs/pdf/build/__pycache__/
.DS_Store
